# Supabase dashboard > Connect: project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternative for existing projects using a legacy anon key. Never use service_role here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional future server-only administrative operations. NOT used by Phase 1.
SUPABASE_SERVICE_ROLE_KEY=
